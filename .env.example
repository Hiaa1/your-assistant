# 复制为 .env 后填写。不要把 .env 提交到 Git。
# 生成密钥：python -c 'import secrets; print(secrets.token_urlsafe(32))'
ASSISTANT_SESSION_SECRET=
# Web 登录密码（手机/电脑都一样）
ASSISTANT_PASSWORD=
# 可选的独立 access key（不填则等同于 ASSISTANT_PASSWORD）。
# 手机可以直接打开 http://<局域网IP>:8000/login?key=<key> 免输密码登录。
ASSISTANT_ACCESS_KEY=
# `your-assistant serve` 启动时是否在终端打印带 key 的链接
ASSISTANT_SHOW_LOGIN_LINK=true
# 用 Tailscale/HTTPS 访问时设为 true；纯局域网 HTTP 用 false。
ASSISTANT_SECURE_COOKIE=false

ASSISTANT_DATA_DIR=./data
ASSISTANT_VAULT_DIR=./vault
ASSISTANT_RULES_FILE=./rules/lessons.md
ASSISTANT_MAIL_RULES_FILE=./rules/mail_rules.yaml
ASSISTANT_MEMORY_DIR=./memory
# 资料索引目录，冒号分隔；默认只索引 vault。想纳入论文项目可写：
# ASSISTANT_INDEX_DIRS=./vault:~/paper_2404
ASSISTANT_INDEX_DIRS=./vault

# 安全默认：只监听本机。要让手机访问必须显式授权（见下）。
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=8000
# 长期允许局域网监听（等价于每次 your-assistant serve --allow-lan）。默认 false。
ASSISTANT_ALLOW_LAN=false
ASSISTANT_TIMEZONE=Asia/Shanghai
ASSISTANT_DAILY_REVIEW_AT=07:30

# ---- 邮箱（只读）----
# 必须使用客户端专用密码，不是统一身份认证密码。
ASSISTANT_EMAIL_ADDRESS=
ASSISTANT_EMAIL_PASSWORD=
# 上科大邮箱服务器（只读方案只用 IMAP；SMTP/POP3 记录在此备查，代码不会使用）：
#   IMAP  imap.shanghaitech.edu.cn  993(SSL) / 143
#   POP3  pop.shanghaitech.edu.cn   995(SSL) / 110
#   SMTP  smtp.shanghaitech.edu.cn   465(SSL) / 25
ASSISTANT_IMAP_HOST=imap.shanghaitech.edu.cn
ASSISTANT_IMAP_PORT=993
# 993 用 SSL；若要改用 143 + STARTTLS，设为 false。
ASSISTANT_IMAP_SSL=true
# 打开后，在网页里读过邮件会同步把服务器标记为已读（写操作）。
ASSISTANT_MARK_SEEN_REMOTE=false
ASSISTANT_MAIL_INTERVAL_SECONDS=300
ASSISTANT_INITIAL_MAIL_LIMIT=50
# 只读是默认策略：下面两个开关默认关闭，且需要对应适配器实现。
ASSISTANT_ALLOW_SEND=false
ASSISTANT_ALLOW_DELETE=false

# ---- LLM ----
# 留空则自动读取 pi 的 ~/.pi/agent/models.json（provider: deepseek）。
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=deepseek-flash
ASSISTANT_PI_PROVIDER=deepseek
# 需要代理时才填，例如 http://127.0.0.1:7890；留空则不继承 shell 代理。
ASSISTANT_LLM_TIMEOUT=180
ASSISTANT_LLM_PROXY=

# ---- 历史 agent 会话（每日复盘用）----
ASSISTANT_AGENT_LOG_ROOT=~/.pi/agent/sessions
ASSISTANT_CODEX_LOG_ROOT=~/.codex/sessions
# 只有要读"另一台机器"的 pi/codex 会话时才填（ssh 别名，逗号分隔）。
# 本机（2404 就是本机）留空即可，复盘会直接读上面的两个目录。
ASSISTANT_REMOTE_AGENT_HOSTS=
